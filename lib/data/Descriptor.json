{
	"openapi": "3.0.2",
	"info": {
		"title": "mia-commands",
		"version": "1.0.0",
		"description": "Command executer plugin for MIA."
	},
	"paths": {
		"/mia-commands/api/descriptor": {
			"get": {
				"description": "",
				"summary": "Plugin's descriptor",
				"operationId": "getPluginDescriptor",
				"responses": {
					"200": {
						"description": "Plugin's descriptor",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-commands/api/status": {
			"get": {
				"description": "",
				"summary": "Plugin's status",
				"operationId": "getPluginStatus",
				"responses": {
					"200": {
						"description": "Plugin's status",
						"content": {
							"application/json": {
								"schema": {
									"type": "string",
									"enum": [ "ENABLED", "INITIALIZED", "RELEASED" ]
								}
							}
						}
					},
					"404": {
						"description": "The plugin is not enabled (=RELEASED)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/mia-commands/public/index.html": {
			"get": {
				"description": "",
				"summary": "Plugin's front",
				"operationId": "getFrontIndex",
				"responses": {
					"200": {
						"description": "Plugin's front",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-commands/public/bundle.min.js": {
			"get": {
				"description": "",
				"summary": "Plugin's front app",
				"operationId": "getFrontApp",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-commands/public/bundle.min.js.map": {
			"get": {
				"description": "",
				"summary": "Plugin's front app map",
				"operationId": "getFrontAppMap",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/mia-commands/api/execute": {
			"put": {
				"description": "",
				"summary": "Execute a new command",
				"operationId": "executeCommand",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/Command"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Running command",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CommandRunning"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}

	},
	"components": {
		"schemas": {
			"PluginName": {
				"type": "string",
				"enum": [ "mia-commands" ]
			},
			"Error": {
				"type": "object",
				"description": "JSON Error description",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [ "code", "message" ]
			},
			"Command": {
				"type": "object",
				"properties": {
					"command": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [ "command" ]
			},
			"CommandRunning": {
				"type": "object",
				"allOf": [
					{
						"$ref": "#/components/schemas/Command"
					},
					{
						"properties": {
							"id": {
								"type": "string"
							},
							"startedAt": {
								"type": "string",
								"format": "date-time"
							}
						},
						"required": [ "id", "startedAt" ]
					}
				]
			},
			"PushEventPluginInitialized": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "initialized" ]
					}
				},
				"required": [ "id", "plugin", "command" ]
			},
			"PushEventPluginReleased": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "released" ]
					}
				},
				"required": [ "id", "plugin", "command" ]
			},
			"PushEventPluginError": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "error" ]
					},
					"data": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			}
		}
	},
	"servers": [
		{
			"url": "http://localhost:8000/",
			"description": "test server"
		}
	]
}
