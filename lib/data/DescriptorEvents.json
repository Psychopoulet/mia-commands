{
	"openapi": "3.0.2",
	"info": {
		"title": "mia-commands - events",
		"version": "2.0.0",
		"description": "Command executer plugin for MIA. Events description.",
		"license": {
			"name": "ISC",
			"url": "https://en.wikipedia.org/wiki/ISC_license"
		}
	},
	"components": {
		"schemas": {
            "PluginName": {
                "$ref": "./Descriptor.json#/components/schemas/PluginName"
            },
			"RegisteredCommand": {
				"$ref": "./Descriptor.json#/components/schemas/RegisteredCommand"
			},
			"RunningCommand": {
				"$ref": "./Descriptor.json#/components/schemas/RunningCommand"
			},
            "Error": {
                "$ref": "./Descriptor.json#/components/schemas/Error"
            },
			"PushEventPluginInitialized": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "initialized" ]
					}
				},
				"required": [ "id", "plugin", "command" ]
			},
			"PushEventPluginReleased": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "released" ]
					}
				},
				"required": [ "id", "plugin", "command" ]
			},
			"PushEventPluginError": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "error" ]
					},
					"data": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventRegisteredCommandAdded": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "registered-command-added" ]
					},
					"data": {
						"$ref": "#/components/schemas/RegisteredCommand"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventRegisteredCommandDeleted": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "registered-command-deleted" ]
					},
					"data": {
						"$ref": "#/components/schemas/RegisteredCommand"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventRunningCommandRunning": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "running-command-running" ]
					},
					"data": {
						"$ref": "#/components/schemas/RunningCommand"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventRunningCommandEnded": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "running-command-ended" ]
					},
					"data": {
						"$ref": "#/components/schemas/RunningCommand"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventRunningCommandFailed": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "running-command-failed" ]
					},
					"data": {
						"type": "object",
						"properties": {
							"command": {
								"$ref": "#/components/schemas/RunningCommand"
							},
							"error": {
								"$ref": "#/components/schemas/Error"
							}
						},
						"required": [ "command", "error" ]
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventRunningCommandLog": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "running-command-log" ]
					},
					"data": {
						"type": "object",
						"properties": {
							"command": {
								"$ref": "#/components/schemas/RunningCommand"
							},
							"content": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [ "command", "content" ]
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventRunningCommandWarning": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "running-command-warning" ]
					},
					"data": {
						"type": "object",
						"properties": {
							"command": {
								"$ref": "#/components/schemas/RunningCommand"
							},
							"content": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [ "command", "content" ]
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			}
		}
	}
}